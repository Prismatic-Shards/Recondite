{
  "model": {
    "type": "minecraft:select",
    "cases": [
      {
        "model": {
          "type": "minecraft:model",
          "model": "recondite:item/fire_spellbook"
        },
        "when": ["firstperson_lefthand", "firstperson_righthand", "thirdperson_lefthand", "thirdperson_righthand", "ground"]
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "recondite:item/fireball_spellbook"
    },
    "property": "minecraft:display_context"
  }
}
